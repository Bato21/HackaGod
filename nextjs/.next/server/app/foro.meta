    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/foro/layout,_N_T_/(app)/foro/page,_N_T_/foro"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/foro/__PAGE__",
    "/!KGFwcCk/foro",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}