    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/atlas/layout,_N_T_/(app)/atlas/page,_N_T_/atlas"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/atlas/__PAGE__",
    "/!KGFwcCk/atlas",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}