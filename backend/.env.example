# Copy to .env and fill the secrets. Never commit .env.

# ── Supabase REST (used by supabase-py) ─────────────────────────────
SUPABASE_URL=https://yiqxyfesywdswtcjaqeq.supabase.co
# Publishable key (safe for client/edge use). Rotate via the dashboard.
SUPABASE_KEY=sb_publishable_7opBFWWoZFJ66qOinh1eFg_aWQd1er_

# ── Direct Postgres via the transaction pooler (asyncpg) ────────────
# Get the exact host/region from: Supabase Dashboard → Project Settings
# → Database → Connection pooling (Transaction mode, port 6543).
# Format:
#   postgresql+asyncpg://postgres.<project_ref>:<DB_PASSWORD>@<pooler-host>:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.yiqxyfesywdswtcjaqeq:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── API ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4
CORS_ORIGINS=http://localhost:3000,http://localhost:5500
DB_ECHO=false
